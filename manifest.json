{
  "manifest_version": 3,
  "name": "mafiauniverse-helper",
  "version": "0.1.0",
  "description": "Automatically saves an open MafiaUniverse game every 5 minutes.",
  "permissions": [
    "alarms",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://mafiauniverse.org/*"
  ],
  "background": {
    "service_worker": "background/auto-save.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mafiauniverse.org/Games/Edit*"],
      "css": [
        "content/ui/ui.css",
        "content/game-players/game-players.css",
        "content/votings/votings.css"
      ],
      "js": [
        "content/ui/ui.js",
        "content/game-players/game-players.js",
        "content/votings/votings.js"
      ]
    }
  ]
}
